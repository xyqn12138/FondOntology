@prefix cnfc: <https://ontology.example.cn/cnfo/code/> .
@prefix cnfo: <https://ontology.example.cn/cnfo/ontology/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# CNFO V0.5.3 数据质量校验层（SHACL）
# 独立于 T-BOX；本文件不通过 owl:imports 进入本体图，
# 由校验工具（pyshacl）显式装载。
# 覆盖：基金、公募/私募基金、基金份额、基金账户、基金份额持仓、基金净值记录、基金业绩记录、基金费率和基金角色任职记录。
# 日期逻辑与代码一致性通过 SHACL-SPARQL 表达。
# ============================================================

cnfo:FundShape a sh:NodeShape ;
    sh:targetClass cnfo:Fund ;
    sh:property [
        sh:path cnfo:fundCode ;
        sh:name "基金代码"@zh ;
        sh:description "基金代码以基金合同为基准的唯一标识，允许 6 至 10 位数字或大写字母。"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:maxLength 10 ;
        sh:pattern "^[0-9A-Z]{6,10}$" ;
    ] ;
    sh:property [
        sh:path cnfo:fundName ;
        sh:name "基金名称"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path cnfo:inceptionDate ;
        sh:name "成立日期"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:hasFundUnit ;
        sh:name "具有基金份额"@zh ;
        sh:description "基金至少发行一个基金份额类别。"@zh ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cnfo:hasFundManagerRole ;
        sh:name "具有基金管理人角色"@zh ;
        sh:description "基金必须具有基金管理人角色。"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cnfo:hasFundOperationMode ;
        sh:name "具有基金运作方式"@zh ;
        sh:description "基金运作方式引用标准代码概念（JR/T 0304.2 DBD00029）。"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:FundOperationModeValue ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "基金终止日期不得早于成立日期"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:inceptionDate ?inc .
                $this cnfo:terminationDate ?term .
                FILTER (?term < ?inc)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "基金运作方式与开放式标志（isOpenEnded）不一致"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:hasFundOperationMode cnfc:FundOperationModeOpenEnded .
                FILTER NOT EXISTS { $this cnfo:isOpenEnded true }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "基金运作方式与开放式标志（isOpenEnded）不一致"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:isOpenEnded true .
                FILTER NOT EXISTS { $this cnfo:hasFundOperationMode cnfc:FundOperationModeOpenEnded }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "当前状态为已终止的基金必须具有终止日期"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:hasFundStatus cnfo:TerminatedStatus .
                FILTER NOT EXISTS { $this cnfo:terminationDate ?terminationDate . }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "同一基金的生命周期状态记录时间区间不得相交"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:hasFundStatusRecord ?left , ?right .
                FILTER (?left != ?right)
                ?left cnfo:effectiveFrom ?leftFrom .
                ?right cnfo:effectiveFrom ?rightFrom .
                OPTIONAL { ?left cnfo:effectiveTo ?leftTo . }
                OPTIONAL { ?right cnfo:effectiveTo ?rightTo . }
                FILTER (
                    (!BOUND(?leftTo) || ?rightFrom <= ?leftTo) &&
                    (!BOUND(?rightTo) || ?leftFrom <= ?rightTo)
                )
            }
        """
    ] .

cnfo:PublicFundShape a sh:NodeShape ;
    sh:targetClass cnfo:PublicFund ;
    sh:property [
        sh:path cnfo:hasFundDepositaryRole ;
        sh:name "具有基金托管人角色"@zh ;
        sh:description "公募基金通常必须具有托管人；托管约束不施加到全部 Fund。"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:FundDepositaryRole ;
    ] .

cnfo:PrivateFundShape a sh:NodeShape ;
    sh:targetClass cnfo:PrivateFund ;
    sh:property [
        sh:path cnfo:filingNumber ;
        sh:name "备案编号"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "私募基金的投资者应为合格投资者"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:hasInvestor ?investor .
                FILTER NOT EXISTS { ?investor a cnfo:QualifiedInvestor . }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "私募基金投资者数量不得达到 200 人"@zh ;
        sh:select """
            SELECT $this WHERE {
                {
                    SELECT $this (COUNT(?investor) AS ?count) WHERE {
                        $this cnfo:hasInvestor ?investor .
                    } GROUP BY $this
                }
                FILTER (?count >= 200)
            }
        """
    ] .

cnfo:FundUnitShape a sh:NodeShape ;
    sh:targetClass cnfo:FundUnit ;
    sh:property [
        sh:path cnfo:fundUnitCode ;
        sh:name "基金份额代码"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:maxLength 10 ;
    ] ;
    sh:property [
        sh:path cnfo:unitCurrency ;
        sh:name "基金份额币种"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{3}$" ;
    ] ;
    sh:property [
        sh:path cnfo:unitQuantity ;
        sh:name "份额数量"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path cnfo:issuedByFund ;
        sh:name "基金份额由基金发行"@zh ;
        sh:description "每份（类）基金份额必须且只能由一个基金发行。"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:Fund ;
    ] .

cnfo:FundPositionShape a sh:NodeShape ;
    sh:targetClass cnfo:FundPosition ;
    sh:property [
        sh:path cnfo:positionQuantity ;
        sh:name "持仓数量"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path cnfo:positionInFundUnit ;
        sh:name "头寸对应基金份额"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:FundUnit ;
    ] ;
    sh:property [
        sh:path cnfo:heldByInvestor ;
        sh:name "基金份额头寸由投资者持有"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:Investor ;
    ] ;
    sh:property [
        sh:path cnfo:positionRecordedInAccount ;
        sh:name "持仓记录于基金账户"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:FundAccount ;
    ] ;
    sh:property [
        sh:path cnfo:positionCurrency ;
        sh:name "持仓币种"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{3}$" ;
    ] .

cnfo:FundAccountShape a sh:NodeShape ;
    sh:targetClass cnfo:FundAccount ;
    sh:property [
        sh:path cnfo:accountNumber ;
        sh:name "账户号码"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:maxLength 20 ;
    ] ;
    sh:property [
        sh:path cnfo:accountOpeningDate ;
        sh:name "开户日期"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:accountForFund ;
        sh:name "账户对应基金"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:Fund ;
    ] .

cnfo:PortfolioPositionShape a sh:NodeShape ;
    sh:targetClass cnfo:PortfolioPosition ;
    sh:property [
        sh:path cnfo:positionInAsset ;
        sh:name "持仓对应投资资产"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:FundInvestmentAsset ;
    ] ;
    sh:property [
        sh:path cnfo:positionQuantity ;
        sh:name "持仓数量"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path cnfo:positionAsOfDate ;
        sh:name "持仓日期"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:positionCurrency ;
        sh:name "持仓币种"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{3}$" ;
    ] .

cnfo:NetAssetValueRecordShape a sh:NodeShape ;
    sh:targetClass cnfo:NetAssetValueRecord ;
    sh:property [
        sh:path cnfo:valuationDate ;
        sh:name "估值日期"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:valuationCurrency ;
        sh:name "估值币种"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{3}$" ;
    ] ;
    sh:property [
        sh:path cnfo:recordForFund ;
        sh:name "净值记录对应基金"@zh ;
        sh:maxCount 1 ;
        sh:class cnfo:Fund ;
    ] ;
    sh:property [
        sh:path cnfo:recordForFundUnit ;
        sh:name "净值记录对应基金份额"@zh ;
        sh:maxCount 1 ;
        sh:class cnfo:FundUnit ;
    ] ;
    sh:property [
        sh:path cnfo:fundUnitNetAssetValue ;
        sh:name "基金份额净值"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path cnfo:fundNetAssetValue ;
        sh:name "基金资产净值"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path cnfo:accumulatedUnitNetAssetValue ;
        sh:name "累计单位净值"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( cnfo:fundUnitNetAssetValue cnfo:fundNetAssetValue ) ] ;
        sh:name "份额净值或资产净值至少一个"@zh ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( cnfo:recordForFund cnfo:recordForFundUnit ) ] ;
        sh:name "净值记录对应基金或基金份额"@zh ;
        sh:minCount 1 ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "同一基金同一估值日不得存在重复的基金级净值记录"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:recordForFund ?fund ;
                      cnfo:valuationDate ?date .
                FILTER NOT EXISTS { $this cnfo:recordForFundUnit ?thisUnit . }
                ?other a cnfo:NetAssetValueRecord ;
                       cnfo:recordForFund ?fund ;
                       cnfo:valuationDate ?date .
                FILTER (?other != $this)
                FILTER NOT EXISTS { ?other cnfo:recordForFundUnit ?otherUnit . }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "同一基金同一基金份额同一估值日不得存在重复的净值记录"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:recordForFundUnit ?unit ;
                      cnfo:valuationDate ?date .
                ?other a cnfo:NetAssetValueRecord ;
                       cnfo:recordForFundUnit ?unit ;
                       cnfo:valuationDate ?date .
                FILTER (?other != $this)
            }
        """
    ] .

cnfo:FundPerformanceRecordShape a sh:NodeShape ;
    sh:targetClass cnfo:FundPerformanceRecord ;
    sh:property [
        sh:path cnfo:performanceForFund ;
        sh:name "业绩记录对应基金"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:Fund ;
    ] ;
    sh:property [
        sh:path cnfo:performancePeriodStart ;
        sh:name "业绩期间起始日"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:performancePeriodEnd ;
        sh:name "业绩期间结束日"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:cumulativeReturn ;
        sh:name "累计收益率"@zh ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path cnfo:annualizedReturn ;
        sh:name "年化收益率"@zh ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path cnfo:maximumDrawdown ;
        sh:name "最大回撤"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "业绩期间结束日不得早于起始日"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:performancePeriodStart ?from ;
                      cnfo:performancePeriodEnd ?to .
                FILTER (?to < ?from)
            }
        """
    ] .

cnfo:FundFeeShape a sh:NodeShape ;
    sh:targetClass cnfo:FundFee ;
    sh:property [
        sh:path cnfo:feeName ;
        sh:name "费率名称"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path cnfo:feeRate ;
        sh:name "费率"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path cnfo:feeAmount ;
        sh:name "收费金额"@zh ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] .

cnfo:FundOfFundsShape a sh:NodeShape ;
    sh:targetClass cnfo:FundOfFunds ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "基金中基金不得将自身作为底层基金"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:hasUnderlyingFund $this .
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "公募基金中基金不得直接持有其他基金中基金份额"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:hasFundPortfolio ?portfolio .
                ?portfolio cnfo:hasFundPortfolioPosition ?position .
                ?position cnfo:positionInAsset ?asset .
                ?asset cnfo:issuedByFund ?underlying .
                ?underlying a cnfo:FundOfFunds .
                FILTER EXISTS { $this a cnfo:PublicFund . }
            }
        """
    ] .

cnfo:FundRoleAssignmentShape a sh:NodeShape ;
    sh:targetClass cnfo:FundRoleAssignment ;
    sh:property [
        sh:path cnfo:assignmentForFund ;
        sh:name "任职记录对应基金"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cnfo:Fund ;
    ] ;
    sh:property [
        sh:path cnfo:assignsFundRole ;
        sh:name "任职记录指定角色"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cnfo:assignmentPlayedBy ;
        sh:name "任职记录由主体承担"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cnfo:effectiveFrom ;
        sh:name "生效日期"@zh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cnfo:effectiveTo ;
        sh:name "失效日期"@zh ;
        sh:datatype xsd:date ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "任职结束日期不得早于开始日期"@zh ;
        sh:select """
            SELECT $this WHERE {
                $this cnfo:effectiveFrom ?from .
                $this cnfo:effectiveTo ?to .
                FILTER (?to < ?from)
            }
        """ ;
    ] .
