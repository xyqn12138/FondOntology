@prefix cnfo: <https://ontology.example.cn/cnfo/ontology/> .
@prefix cnfom: <https://ontology.example.cn/cnfo/module/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cnfo:CNFODomain a owl:Ontology, cnfom:OntologyModule ;
    rdfs:label "CNFO 基金领域入口"@zh ;
    dcterms:modified "2026-09-01"^^xsd:date ;
    owl:imports cnfom:CNFOModuleVocabulary,
        cnfo:CNFOFundOntology ;
    owl:versionInfo "0.5.2" ;
    cnfom:moduleFile "cnfo-domain.ttl" ;
    cnfom:moduleKind "domain-entry" ;
    cnfom:moduleOrder 0 ;
    skos:definition "CNFO 当前基金领域的本地组合入口。当前只挂载已实际建模的基金本体，未来可按需要增加其他模块。"@zh .
