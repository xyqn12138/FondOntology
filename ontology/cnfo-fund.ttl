@prefix cnfo: <https://ontology.example.cn/cnfo/ontology/> .
@prefix cnfc: <https://ontology.example.cn/cnfo/code/> .
@prefix cnfom: <https://ontology.example.cn/cnfo/module/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cnfo:ChinaFundOntology a owl:Ontology ;
    rdfs:label "中国基金领域本体兼容入口"@zh ;
    dcterms:modified "2026-09-01"^^xsd:date ;
    owl:imports cnfo:CNFOFundOntology ;
    owl:versionInfo "0.5.2" ;
    skos:definition "兼容旧入口标识；完整基金业务术语定义位于 CNFO 基金本体模块。"@zh .

cnfo:ActiveInvestmentStrategy a owl:Class ;
    rdfs:label "主动投资策略"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentStrategy ;
    skos:definition "通过主动研究和交易选择投资标的、配置比例或交易时机，以争取超越基准收益的基金投资策略。"@zh .

cnfo:AssetValuationActivity a owl:Class ;
    rdfs:label "基金资产估值活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "按照适用规则对基金资产、负债或相关权益进行价值计量的基金业务活动。"@zh .

cnfo:BondFund a owl:Class ;
    rdfs:label "债券基金"@zh ;
    rdfs:subClassOf cnfo:Fund ;
    skos:definition "以债券等固定收益类资产为主要投资对象的基金分类。"@zh .

cnfo:CNFOFundOntology a owl:Ontology,
        cnfom:OntologyModule ;
    rdfs:label "基金本体"@zh ;
    rdfs:comment "参考本地 FIBO SEC/Funds 模块、以中国基金业务语境独立定义的基金领域 T-BOX。"@zh ;
    dcterms:modified "2026-09-01"^^xsd:date ;
    owl:imports cnfom:CNFOModuleVocabulary,
        cnfc:CNFOFundCodes ;
    owl:versionInfo "0.5.2" ;
    skos:changeNote "v0.5.0 语义契约完善版本：① 完善基础抽象（新增基金业务对象 FundBusinessObject、基金账户 FundAccount 与 6 个代码取值类，业务对象重新挂载）；② 全部对象/数据属性补齐中文定义 skos:definition，形成属性关系契约；③ 代码表语义化：导入 SKOS 受控代码表（基金运作方式/组织形式/分红方式/风险等级/私募基金类型/收费方式），新增 6 个代码引用对象属性，类与代码概念建立 skos:closeMatch，isOpenEnded/isPrivate 等标注为兼容属性；④ 保留全部 IRI，兼容冻结策略。v0.5.1 语义勘误：新增基金持仓记录 FundPositionRecord 作为 FundPosition 与 PortfolioPosition 的共同父类，并将 positionQuantity、positionCurrency 的 domain 提升至该抽象类，修复示例数据触发的交叉类型推断。v0.5.2 基础概念补全：新增跨境基金与内地/香港互认基金层级，新增基金代理人机构主体、基金代理人角色及其基金关联关系。"@zh ;
    skos:definition "当前唯一已实际建模的 CNFO 基金业务模块，包含基金、基金产品、基金参与方、基金活动、基金资产、基金份额、组合、持仓和净值记录等概念及其约束。"@zh ;
    cnfom:containsTerm cnfo:ActiveInvestmentStrategy,
        cnfo:AssetValuationActivity,
        cnfo:BondFund,
        cnfo:ClosedEndedFund,
        cnfo:ConceptNature,
        cnfo:ContractualFundStructure,
