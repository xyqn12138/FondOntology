cnfo:DebtInvestmentAsset a owl:Class ;
    rdfs:label "债券类投资资产"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentAsset ;
    skos:definition "以债券、债权或其他具有债务属性的金融工具为代表的基金投资资产。"@zh .

cnfo:EquityFund a owl:Class ;
    rdfs:label "股票型基金"@zh ;
    rdfs:subClassOf cnfo:Fund ;
    skos:definition "以股票等权益类资产为主要投资对象的基金分类。"@zh .

cnfo:EquityInvestmentAsset a owl:Class ;
    rdfs:label "权益类投资资产"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentAsset ;
    skos:definition "以股票、股权或其他具有权益属性的金融工具为代表的基金投资资产。"@zh .

cnfo:ExchangeTradedFund a owl:Class ;
    rdfs:label "交易型开放式指数基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty cnfo:isExchangeTraded ],
        cnfo:OpenEndedFund ;
    skos:altLabel "ETF"@zh ;
    skos:definition "以交易所交易和指数化投资为主要特征、可在交易所上市交易的开放式基金。"@zh .

cnfo:FundFilingActivity a owl:Class ;
    rdfs:label "基金备案活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "向适用登记备案机构提交基金备案材料并完成备案手续的基金业务活动。"@zh .

cnfo:FundFilingDocument a owl:Class ;
    rdfs:label "基金备案文件"@zh ;
    rdfs:subClassOf cnfo:FundDocument ;
    skos:definition "用于证明或支持基金登记备案事项的业务文件。"@zh .

cnfo:FundHolderRole a owl:Class ;
    rdfs:label "基金份额持有人角色"@zh ;
    rdfs:subClassOf cnfo:FundRole ;
    skos:definition "由基金份额持有人承担、表示其在特定基金中持有基金份额权利的基金角色。"@zh .

cnfo:FundLiquidationActivity a owl:Class ;
    rdfs:label "基金清算活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "基金终止后对基金财产进行清理、分配并办理注销等事项的基金业务活动。"@zh .

cnfo:FundManagementCompany a owl:Class ;
    rdfs:label "基金管理公司"@zh ;
    rdfs:subClassOf cnfo:FundParty ;
    skos:definition "依法设立并承担基金管理职责或提供基金管理服务的基金参与主体。"@zh .

cnfo:FundPeriodicReport a owl:Class ;
    rdfs:label "基金定期报告"@zh ;
    rdfs:subClassOf cnfo:FundDocument ;
    skos:definition "按照规定定期披露基金资产、投资运作、财务状况和其他重要事项的基金报告。"@zh .

cnfo:FundPurchaseActivity a owl:Class ;
    rdfs:label "基金申购活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "基金份额持有人按照适用规则申请并完成基金份额申购的业务活动。"@zh .

cnfo:FundRaisingActivity a owl:Class ;
    rdfs:label "基金募集活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "基金面向投资者发售或募集基金份额的业务活动。"@zh .

cnfo:FundRedemptionActivity a owl:Class ;
    rdfs:label "基金赎回活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "基金份额持有人按照适用规则申请并完成基金份额赎回的业务活动。"@zh .

cnfo:FundRegistrationActivity a owl:Class ;
    rdfs:label "基金注册活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "依法向适用注册机构提交基金注册材料并完成注册程序的基金业务活动。"@zh .

cnfo:FundSubscriptionActivity a owl:Class ;
    rdfs:label "基金认购活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "投资者按照基金募集安排申请并完成基金份额认购的业务活动。"@zh .

cnfo:FundUnitInvestmentAsset a owl:Class ;
    rdfs:label "基金份额类投资资产"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentAsset,
        cnfo:FundUnit ;
    skos:definition "以其他基金份额或基金单位形式存在的基金投资资产。"@zh .

cnfo:FundValuationServiceProviderRole a owl:Class ;
    rdfs:label "基金估值服务机构角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金估值服务机构承担、负责基金资产或份额估值相关服务的基金服务机构角色。"@zh .

cnfo:GovernmentGuidanceFund a owl:Class ;
    rdfs:label "政府引导基金"@zh ;
    rdfs:subClassOf cnfo:GovernmentInvestmentFund ;
    skos:definition "通过政府资金撬动社会资本、服务特定政策目标的基金或基金安排。"@zh .

cnfo:GrowthObjective a owl:Class ;
    rdfs:label "增长型投资目标"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentObjective ;
    skos:definition "以资本增值或长期资产增长为主要取向的基金投资目标。"@zh .

cnfo:HybridFund a owl:Class ;
    rdfs:label "混合基金"@zh ;
    rdfs:subClassOf cnfo:Fund ;
    skos:definition "同时配置股票、债券或其他多类资产，且不属于单一资产类别基金的基金。"@zh .

cnfo:IncomeDistributionActivity a owl:Class ;
    rdfs:label "基金收益分配活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "按照基金合同或适用规则计算并实施基金收益分配的业务活动。"@zh .

cnfo:IncomeObjective a owl:Class ;
    rdfs:label "收入型投资目标"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentObjective ;
    skos:definition "以获得利息、股息、分红或其他稳定收益为主要取向的基金投资目标。"@zh .

cnfo:IndexTrackingStrategy a owl:Class ;
    rdfs:label "指数跟踪策略"@zh ;
    rdfs:subClassOf cnfo:PassiveInvestmentStrategy ;
    skos:definition "以复制、跟踪特定指数表现为主要方法的被动投资策略。"@zh .

cnfo:InformationDisclosureActivity a owl:Class ;
    rdfs:label "基金信息披露活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "按照适用规则编制、提交或向投资者公开基金信息的业务活动。"@zh .

cnfo:InfrastructurePublicREIT a owl:Class ;
    rdfs:label "基础设施公募 REIT"@zh ;
    rdfs:subClassOf cnfo:PublicFund ;
    skos:definition "依法公开募集并主要通过资产支持证券等安排投资基础设施项目的证券投资基金。"@zh .

cnfo:ListedOpenEndedFund a owl:Class ;
    rdfs:label "上市开放式基金"@zh ;
    rdfs:subClassOf cnfo:OpenEndedFund ;
    skos:altLabel "LOF"@zh ;
    skos:definition "基金份额可在证券交易场所上市交易，同时按照规则办理申购或赎回的开放式基金。"@zh .

cnfo:MarketConventionType a owl:Class ;
    rdfs:label "市场惯用类型"@zh ;
    rdfs:subClassOf cnfo:ConceptNature ;
    skos:definition "在基金市场实践中形成并被广泛使用、但不必然构成法定分类的概念类型。"@zh .

cnfo:MoneyMarketFund a owl:Class ;
    rdfs:label "货币市场基金"@zh ;
    rdfs:subClassOf cnfo:Fund ;
    skos:definition "主要投资于货币市场工具并以保持流动性和稳健性为主要特征的基金。"@zh .

cnfo:NetAssetValueCalculationActivity a owl:Class ;
    rdfs:label "基金净值计算活动"@zh ;
    rdfs:subClassOf cnfo:FundActivity ;
    skos:definition "按照适用规则计算基金资产净值或基金份额净值的业务活动。"@zh .

cnfo:PensionTargetFund a owl:Class ;
    rdfs:label "养老目标基金"@zh ;
    rdfs:subClassOf cnfo:FundOfFunds,
        cnfo:PublicFund ;
    skos:definition "以养老目标为导向并按照适用规则通过资产配置或基金组合进行长期投资的基金。"@zh .

cnfo:PeriodicOpenEndedFund a owl:Class ;
    rdfs:label "定期开放式基金"@zh ;
    rdfs:subClassOf cnfo:OpenEndedFund ;
    skos:definition "在约定开放期办理申购赎回、其他期间限制交易的开放式基金。"@zh .

cnfo:PrivateEquityFund a owl:Class ;
    rdfs:label "私募股权投资基金"@zh ;
    rdfs:subClassOf cnfo:PrivateFund ;
    skos:definition "主要投资未上市企业股权等规定标的的私募基金。"@zh .

cnfo:PrivateRealEstateInvestmentFund a owl:Class ;
    rdfs:label "不动产私募投资基金"@zh ;
    rdfs:subClassOf cnfo:PrivateFund ;
    skos:definition "以不动产或不动产相关权益为主要投资对象的私募基金。"@zh .

cnfo:PrivateSecuritiesInvestmentFund a owl:Class ;
    rdfs:label "私募证券投资基金"@zh ;
    rdfs:subClassOf cnfo:PrivateFund,
        cnfo:SecuritiesInvestmentFund ;
    skos:definition "主要投资证券及其衍生品等规定标的的私募基金。"@zh .

cnfo:PublicSecuritiesInvestmentFund a owl:Class ;
    rdfs:label "公募证券投资基金"@zh ;
    rdfs:subClassOf cnfo:PublicFund,
        cnfo:SecuritiesInvestmentFund ;
    skos:definition "公开募集且主要投资证券及其衍生品等规定标的的基金。"@zh .

cnfo:QDIIFund a owl:Class ;
    rdfs:label "合格境内机构投资者基金"@zh ;
    rdfs:subClassOf cnfo:PublicFund ;
    skos:altLabel "QDII 基金"@zh ;
    skos:definition "在境内募集资金并按照批准范围投资境外证券市场的基金。"@zh .

cnfo:QualifiedInvestor a owl:Class ;
    rdfs:label "合格投资者"@zh ;
    rdfs:subClassOf cnfo:Investor ;
    skos:definition "符合适用法律法规或监管规则所规定资格条件的基金投资者。"@zh .

cnfo:RegulatoryProductType a owl:Class ;
    rdfs:label "监管产品类型"@zh ;
    rdfs:subClassOf cnfo:ConceptNature ;
    skos:definition "由监管规则、登记备案制度或产品监管口径定义的基金产品类型。"@zh .

cnfo:StatutoryFundType a owl:Class ;
    rdfs:label "法定基金类型"@zh ;
    rdfs:subClassOf cnfo:ConceptNature ;
    skos:definition "由法律、行政法规或正式监管规范直接规定的基金类型。"@zh .

cnfo:VentureCapitalFund a owl:Class ;
    rdfs:label "创业投资基金"@zh ;
    rdfs:subClassOf cnfo:PrivateFund ;
    skos:definition "主要投资未上市成长性或创新创业企业，并符合适用监管认定条件的基金。"@zh .

cnfo:baseCurrency a owl:DatatypeProperty ;
    rdfs:label "基础币种"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:benchmarkName a owl:DatatypeProperty ;
    rdfs:label "业绩比较基准名称"@zh ;
    rdfs:domain cnfo:FundBenchmark ;
    rdfs:range xsd:string .

cnfo:classificationCode a owl:DatatypeProperty ;
    rdfs:label "分类代码"@zh ;
    rdfs:domain cnfo:FundClassifier ;
    rdfs:range xsd:string .

cnfo:filingDate a owl:DatatypeProperty ;
    rdfs:label "备案日期"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:date .

cnfo:filingNumber a owl:DatatypeProperty ;
    rdfs:label "备案编号"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:fundCode a owl:DatatypeProperty ;
    rdfs:label "基金代码"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:fundName a owl:DatatypeProperty ;
    rdfs:label "基金名称"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:fundNetAssetValue a owl:DatatypeProperty ;
    rdfs:label "基金资产净值"@zh ;
    rdfs:domain cnfo:NetAssetValueRecord ;
    rdfs:range xsd:decimal .

cnfo:fundShortName a owl:DatatypeProperty ;
    rdfs:label "基金简称"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:fundTypeCode a owl:DatatypeProperty ;
    rdfs:label "基金类型代码"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:fundUnitCode a owl:DatatypeProperty ;
    rdfs:label "基金份额代码"@zh ;
    rdfs:domain cnfo:FundUnit ;
    rdfs:range xsd:string .

cnfo:fundUnitNetAssetValue a owl:DatatypeProperty ;
    rdfs:label "基金份额净值"@zh ;
    rdfs:domain cnfo:NetAssetValueRecord ;
    rdfs:range xsd:decimal .

cnfo:hasConceptNature a owl:ObjectProperty ;
    rdfs:label "具有概念性质"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:ConceptNature .

cnfo:hasFundAccountantRole a owl:ObjectProperty ;
    rdfs:label "具有基金会计服务机构角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundAccountantRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasFundAdministratorRole a owl:ObjectProperty ;
    rdfs:label "具有基金行政管理机构角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundAdministratorRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasFundDepositaryRole a owl:ObjectProperty ;
    rdfs:label "具有基金托管人角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundDepositaryRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasFundDistributorRole a owl:ObjectProperty ;
    rdfs:label "具有基金销售机构角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundDistributorRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasFundRegistrarRole a owl:ObjectProperty ;
    rdfs:label "具有基金份额登记机构角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundRegistrarRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasFundTransferAgentRole a owl:ObjectProperty ;
    rdfs:label "具有基金过户登记代理角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundTransferAgentRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasInvestor a owl:ObjectProperty ;
    rdfs:label "具有投资者"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:Investor ;
    rdfs:subPropertyOf cnfo:hasFundParty .

cnfo:inceptionDate a owl:DatatypeProperty ;
    rdfs:label "成立日期"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:date .

cnfo:investmentAssetTypeCode a owl:DatatypeProperty ;
    rdfs:label "投资资产类型代码"@zh ;
    rdfs:domain cnfo:FundPortfolioInvestmentLimitation ;
    rdfs:range xsd:string .

cnfo:investmentFocus a owl:DatatypeProperty ;
    rdfs:label "投资重点"@zh ;
    rdfs:domain cnfo:FundInvestmentStrategy ;
    rdfs:range xsd:string .

cnfo:isClassifiedBy a owl:ObjectProperty ;
    rdfs:label "被分类为"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundClassifier ;
    rdfs:subPropertyOf cnfo:hasFundClassifier .

cnfo:issuesFundUnit a owl:ObjectProperty ;
    rdfs:label "发行基金份额"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundUnit ;
    rdfs:subPropertyOf cnfo:hasFundUnit .

cnfo:jurisdictionCode a owl:DatatypeProperty ;
    rdfs:label "法域代码"@zh ;
    rdfs:domain cnfo:FundJurisdiction ;
    rdfs:range xsd:string .

cnfo:maximumInvestmentPercentage a owl:DatatypeProperty ;
    rdfs:label "最高投资比例"@zh ;
    rdfs:domain cnfo:FundPortfolioInvestmentLimitation ;
    rdfs:range xsd:decimal .

cnfo:minimumInvestmentPercentage a owl:DatatypeProperty ;
    rdfs:label "最低投资比例"@zh ;
    rdfs:domain cnfo:FundPortfolioInvestmentLimitation ;
    rdfs:range xsd:decimal .

cnfo:positionCurrency a owl:DatatypeProperty ;
    rdfs:label "持仓币种"@zh ;
    rdfs:domain cnfo:FundPositionRecord ;
    rdfs:range xsd:string .

cnfo:positionMarketValue a owl:DatatypeProperty ;
    rdfs:label "持仓市值"@zh ;
    rdfs:domain cnfo:PortfolioPosition ;
    rdfs:range xsd:decimal .

cnfo:realizesFundProduct a owl:ObjectProperty ;
    rdfs:label "实现基金产品"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundProduct ;
    rdfs:subPropertyOf cnfo:hasFundProduct .

cnfo:redemptionInAmountAllowed a owl:DatatypeProperty ;
    rdfs:label "是否允许按金额赎回"@zh ;
    rdfs:domain cnfo:FundRedemptionTerms ;
    rdfs:range xsd:boolean .

cnfo:redemptionMinimumUnits a owl:DatatypeProperty ;
    rdfs:label "最低赎回份额"@zh ;
    rdfs:domain cnfo:FundRedemptionTerms ;
    rdfs:range xsd:decimal .

cnfo:registrationNumber a owl:DatatypeProperty ;
    rdfs:label "注册编号"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:riskLevelCode a owl:DatatypeProperty ;
    rdfs:label "风险等级代码"@zh ;
    rdfs:domain cnfo:FundRiskLevel ;
    rdfs:range xsd:string .

cnfo:sourceIdentifier a owl:DatatypeProperty ;
    rdfs:label "来源标识"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:string .

cnfo:subscriptionMinimumAmount a owl:DatatypeProperty ;
    rdfs:label "最低认购金额"@zh ;
    rdfs:domain cnfo:FundSubscriptionTerms ;
    rdfs:range xsd:decimal .

cnfo:subscriptionMinimumUnits a owl:DatatypeProperty ;
    rdfs:label "最低认购份额"@zh ;
    rdfs:domain cnfo:FundSubscriptionTerms ;
    rdfs:range xsd:decimal .

cnfo:terminationDate a owl:DatatypeProperty ;
    rdfs:label "终止日期"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:date .

cnfo:unitQuantity a owl:DatatypeProperty ;
    rdfs:label "份额数量"@zh ;
    rdfs:domain cnfo:FundUnit ;
    rdfs:range xsd:decimal .

cnfo:ClosedEndedFund a owl:Class ;
    rdfs:label "封闭式基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty cnfo:isOpenEnded ],
        cnfo:Fund ;
    skos:definition "合同期限内基金份额总额固定，通常不办理日常赎回的基金。"@zh .

cnfo:ContractualFundStructure a owl:Class ;
    rdfs:label "契约型基金结构"@zh ;
    rdfs:subClassOf cnfo:FundLegalStructure ;
    skos:definition "通过基金合同约定基金当事人权利义务和基金运作规则的基金法律结构。"@zh .

cnfo:CorporateFundStructure a owl:Class ;
    rdfs:label "公司型基金结构"@zh ;
    rdfs:subClassOf cnfo:FundLegalStructure ;
    skos:definition "以公司法人作为基金组织载体并依公司治理规则运作的基金法律结构。"@zh .

cnfo:DesignedStatus a owl:Class ;
    rdfs:label "已设计"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已完成产品设计但尚未进入注册、备案或募集阶段的生命周期状态。"@zh .

cnfo:FiledStatus a owl:Class ;
    rdfs:label "已备案"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已完成适用的备案程序并进入备案后运作或后续管理阶段的生命周期状态。"@zh .

cnfo:FundAccountantRole a owl:Class ;
    rdfs:label "基金会计服务机构角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金会计服务机构承担、负责基金会计核算或相关财务记录工作的基金服务机构角色。"@zh .

cnfo:FundAdministratorRole a owl:Class ;
    rdfs:label "基金行政管理机构角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金行政管理机构承担、负责基金运营支持、记录维护或行政管理工作的基金服务机构角色。"@zh .

cnfo:FundCashDistributionPolicy a owl:Class ;
    rdfs:label "基金现金分红政策"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty cnfo:distributionWithReinvestment ],
        cnfo:FundUnitDistributionPolicy ;
    skos:definition "约定基金收益以现金形式向基金份额持有人进行分配的份额分配政策。"@zh .

cnfo:FundClassificationScheme a owl:Class ;
    rdfs:label "基金分类体系"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:definesClassification ;
            owl:someValuesFrom cnfo:FundClassification ],
        cnfo:FundObject ;
    skos:definition "规定基金分类维度、分类规则及分类概念集合的基金分类体系。"@zh .

cnfo:FundDistributionPolicy a owl:Class ;
    rdfs:label "基金收益分配政策"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentSpecification ;
    skos:definition "规定基金收益分配原则、条件、频率或处理方式的政策对象。"@zh .

cnfo:FundDistributorRole a owl:Class ;
    rdfs:label "基金销售机构角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金销售机构承担、负责基金份额发售、申购或赎回服务的基金服务机构角色。"@zh .

cnfo:FundRegistrarRole a owl:Class ;
    rdfs:label "基金份额登记机构角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金份额登记机构承担、负责基金份额登记、持有人名册和相关记录管理的服务机构角色。"@zh .

cnfo:FundReinvestmentPolicy a owl:Class ;
    rdfs:label "基金收益再投资政策"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty cnfo:distributionWithReinvestment ],
        cnfo:FundUnitDistributionPolicy ;
    skos:definition "约定基金收益分配后将收益用于再投资或增加基金份额的份额分配政策。"@zh .

cnfo:FundTransferAgentRole a owl:Class ;
    rdfs:label "基金过户登记代理角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金过户登记代理机构承担、负责份额过户或相关登记代理服务的基金服务机构角色。"@zh .

cnfo:GovernmentInvestmentFund a owl:Class ;
    rdfs:label "政府投资基金"@zh ;
    rdfs:subClassOf cnfo:Fund ;
    skos:definition "由政府出资设立、采用市场化方式投资并服务政策目标的基金。"@zh .

cnfo:LiquidatingStatus a owl:Class ;
    rdfs:label "清算中"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已进入清算程序，正在处置资产、清偿债务或分配剩余财产的生命周期状态。"@zh .

cnfo:OperatingStatus a owl:Class ;
    rdfs:label "运作中"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已完成设立或募集程序并处于正常投资运作阶段的生命周期状态。"@zh .

cnfo:PartnershipFundStructure a owl:Class ;
    rdfs:label "合伙型基金结构"@zh ;
    rdfs:subClassOf cnfo:FundLegalStructure ;
    skos:definition "以合伙企业作为组织载体并依合伙协议及合伙法律关系运作的基金法律结构。"@zh .

cnfo:PassiveInvestmentStrategy a owl:Class ;
    rdfs:label "被动投资策略"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentStrategy ;
    skos:definition "按照预定指数、规则或组合方法进行投资，较少主动择时和选券的投资策略。"@zh .

cnfo:RaisingStatus a owl:Class ;
    rdfs:label "募集期"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金正在面向投资者募集基金份额、尚未进入正常运作阶段的生命周期状态。"@zh .

cnfo:RegisteredStatus a owl:Class ;
    rdfs:label "已注册"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已完成适用注册程序并取得注册或批准结果的生命周期状态。"@zh .

cnfo:RegistrationPendingStatus a owl:Class ;
    rdfs:label "待注册"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已提交或准备注册材料、但尚未完成注册程序的生命周期状态。"@zh .

cnfo:SuspendedStatus a owl:Class ;
    rdfs:label "暂停运作"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金因适用原因暂时停止全部或部分募集、申购、赎回或投资运作的生命周期状态。"@zh .

cnfo:TerminatedStatus a owl:Class ;
    rdfs:label "已终止"@zh ;
    rdfs:subClassOf cnfo:FundLifecycleStatus ;
    skos:definition "基金已完成清算或其他终止程序，不再继续作为运作中基金存在的生命周期状态。"@zh .

cnfo:activityOfFund a owl:ObjectProperty ;
    rdfs:label "业务活动对应基金"@zh ;
    rdfs:domain cnfo:FundActivity ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundActivity .

cnfo:appliesToFundUnit a owl:ObjectProperty ;
    rdfs:label "适用于基金份额"@zh ;
    rdfs:domain cnfo:FundSubscriptionTerms ;
    rdfs:range cnfo:FundUnit .

cnfo:assetHasPortfolioPosition a owl:ObjectProperty ;
    rdfs:label "投资资产具有组合持仓"@zh ;
    rdfs:domain cnfo:FundInvestmentAsset ;
    rdfs:range cnfo:PortfolioPosition ;
    owl:inverseOf cnfo:positionInAsset .

cnfo:assignmentPlayedBy a owl:ObjectProperty ;
    rdfs:label "任职记录由主体承担"@zh ;
    rdfs:domain cnfo:FundRoleAssignment ;
    rdfs:range cnfo:FundParty .

cnfo:assignsFundRole a owl:ObjectProperty ;
    rdfs:label "任职记录指定角色"@zh ;
    rdfs:domain cnfo:FundRoleAssignment ;
    rdfs:range cnfo:FundRole .

cnfo:definesClassification a owl:ObjectProperty ;
    rdfs:label "分类体系定义分类"@zh ;
    rdfs:domain cnfo:FundClassificationScheme ;
    rdfs:range cnfo:FundClassification .

cnfo:definesInvestmentRestriction a owl:ObjectProperty ;
    rdfs:label "定义投资限制"@zh ;
    rdfs:domain cnfo:FundInvestmentPolicy ;
    rdfs:range cnfo:FundInvestmentRestriction .

cnfo:describedBy a owl:ObjectProperty ;
    rdfs:label "由基金文件描述"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundProspectus ;
    rdfs:subPropertyOf cnfo:hasFundDocument ;
    owl:inverseOf cnfo:describesFund .

cnfo:describesFund a owl:ObjectProperty ;
    rdfs:label "基金文件描述基金"@zh ;
    rdfs:domain cnfo:FundProspectus ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:describedBy .

cnfo:fundEstateOf a owl:ObjectProperty ;
    rdfs:label "基金财产对应基金"@zh ;
    rdfs:domain cnfo:FundEstate ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundEstate .

cnfo:fundProductOf a owl:ObjectProperty ;
    rdfs:label "基金产品对应基金"@zh ;
    rdfs:domain cnfo:FundProduct ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundProduct .

cnfo:fundUnitClassOf a owl:ObjectProperty ;
    rdfs:label "基金份额类别对应基金"@zh ;
    rdfs:domain cnfo:FundUnitClass ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundUnitClass .

cnfo:governedBy a owl:ObjectProperty ;
    rdfs:label "受基金合同约束"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundContract ;
    rdfs:subPropertyOf cnfo:hasFundDocument ;
    owl:inverseOf cnfo:governsFund .

cnfo:governsFund a owl:ObjectProperty ;
    rdfs:label "基金合同约束基金"@zh ;
    rdfs:domain cnfo:FundContract ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:governedBy .

cnfo:governsInvestmentStrategy a owl:ObjectProperty ;
    rdfs:label "约束投资策略"@zh ;
    rdfs:domain cnfo:FundInvestmentPolicy ;
    rdfs:range cnfo:FundInvestmentStrategy .

cnfo:hasApplicableJurisdiction a owl:ObjectProperty ;
    rdfs:label "适用基金法域"@zh ;
    rdfs:domain cnfo:FundLegalStructure ;
    rdfs:range cnfo:FundJurisdiction .

cnfo:hasDistributionMethod a owl:ObjectProperty ;
    rdfs:label "采用基金分红方式"@zh ;
    rdfs:domain cnfo:FundUnitDistributionPolicy ;
    rdfs:range cnfo:FundDistributionMethod .

cnfo:hasDistributionPolicy a owl:ObjectProperty ;
    rdfs:label "具有份额分配政策"@zh ;
    rdfs:domain cnfo:FundUnitClass ;
    rdfs:range cnfo:FundUnitDistributionPolicy .

cnfo:hasFundActivity a owl:ObjectProperty ;
    rdfs:label "具有基金业务活动"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundActivity ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:activityOfFund .

cnfo:hasFundEstate a owl:ObjectProperty ;
    rdfs:label "具有基金财产"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundEstate ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:fundEstateOf .

cnfo:hasFundManagerRole a owl:ObjectProperty ;
    rdfs:label "具有基金管理人角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundManagerRole ;
    rdfs:subPropertyOf cnfo:hasFundServiceProviderRole .

cnfo:hasFundPortfolio a owl:ObjectProperty ;
    rdfs:label "具有基金投资组合"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundPortfolio ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:portfolioOfFund .

cnfo:hasFundPosition a owl:ObjectProperty ;
    rdfs:label "基金份额具有持仓"@zh ;
    rdfs:domain cnfo:FundUnit ;
    rdfs:range cnfo:FundPosition ;
    owl:inverseOf cnfo:positionInFundUnit .

cnfo:hasFundRedemptionTerms a owl:ObjectProperty ;
    rdfs:label "具有赎回条款"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundRedemptionTerms ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:redemptionTermsForFund .

cnfo:hasFundRoleAssignment a owl:ObjectProperty ;
    rdfs:label "具有基金角色任职记录"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundRoleAssignment ;
    rdfs:subPropertyOf cnfo:hasFundRecord ;
    owl:inverseOf cnfo:assignmentForFund .

cnfo:hasFundStatus a owl:ObjectProperty ;
    rdfs:label "具有基金状态"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundLifecycleStatus ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:statusOfFund .

cnfo:hasFundSubscriptionTerms a owl:ObjectProperty ;
    rdfs:label "具有认购条款"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundSubscriptionTerms ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:subscriptionTermsForFund .

cnfo:hasFundSupervisor a owl:ObjectProperty ;
    rdfs:label "具有基金监管机构"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundSupervisor ;
    rdfs:subPropertyOf cnfo:hasFundParty ;
    owl:inverseOf cnfo:supervisesFund .

cnfo:hasFundUnitClass a owl:ObjectProperty ;
    rdfs:label "具有基金份额类别"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundUnitClass ;
    rdfs:subPropertyOf cnfo:hasFundUnit ;
    owl:inverseOf cnfo:fundUnitClassOf .

cnfo:hasIntendedRiskLevel a owl:ObjectProperty ;
    rdfs:label "具有目标风险等级"@zh ;
    rdfs:domain cnfo:FundInvestmentObjective ;
    rdfs:range cnfo:FundRiskLevel .

cnfo:hasInvestmentObjective a owl:ObjectProperty ;
    rdfs:label "具有投资目标"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundInvestmentObjective ;
    rdfs:subPropertyOf cnfo:hasInvestmentSpecification ;
    owl:inverseOf cnfo:objectiveOfFund .

cnfo:hasInvestmentPolicy a owl:ObjectProperty ;
    rdfs:label "具有投资政策"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundInvestmentPolicy ;
    rdfs:subPropertyOf cnfo:hasInvestmentSpecification ;
    owl:inverseOf cnfo:policyOfFund .

cnfo:hasInvestmentRestriction a owl:ObjectProperty ;
    rdfs:label "招募说明书载明投资限制"@zh ;
    rdfs:domain cnfo:FundProspectus ;
    rdfs:range cnfo:FundInvestmentRestriction ;
    owl:inverseOf cnfo:definedInProspectus .

cnfo:hasNetAssetValueRecord a owl:ObjectProperty ;
    rdfs:label "具有净值记录"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:NetAssetValueRecord ;
    rdfs:subPropertyOf cnfo:hasFundRecord ;
    owl:inverseOf cnfo:recordForFund .

cnfo:hasPortfolioInvestmentStrategy a owl:ObjectProperty ;
    rdfs:label "投资组合采用策略"@zh ;
    rdfs:domain cnfo:FundPortfolio ;
    rdfs:range cnfo:FundInvestmentStrategy .

cnfo:hasStatusValue a owl:ObjectProperty ;
    rdfs:label "状态记录的状态值"@zh ;
    rdfs:domain cnfo:FundStatusRecord ;
    rdfs:range cnfo:FundLifecycleStatus .

cnfo:holdsFundPosition a owl:ObjectProperty ;
    rdfs:label "持有基金份额头寸"@zh ;
    rdfs:domain cnfo:Investor ;
    rdfs:range cnfo:FundPosition ;
    owl:inverseOf cnfo:heldByInvestor .

cnfo:implementsInvestmentPolicy a owl:ObjectProperty ;
    rdfs:label "投资组合执行政策"@zh ;
    rdfs:domain cnfo:FundPortfolio ;
    rdfs:range cnfo:FundPortfolioInvestmentPolicy .

cnfo:isExchangeTraded a owl:DatatypeProperty ;
    rdfs:label "是否交易所交易"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:boolean .

cnfo:legalStructureOf a owl:ObjectProperty ;
    rdfs:label "基金组织形式对应基金"@zh ;
    rdfs:domain cnfo:FundLegalStructure ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasLegalStructure .

cnfo:objectiveOfFund a owl:ObjectProperty ;
    rdfs:label "投资目标对应基金"@zh ;
    rdfs:domain cnfo:FundInvestmentObjective ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasInvestmentObjective .

cnfo:outlinesObjective a owl:ObjectProperty ;
    rdfs:label "基金招募说明书载明投资目标"@zh ;
    rdfs:domain cnfo:FundProspectus ;
    rdfs:range cnfo:FundInvestmentObjective ;
    owl:inverseOf cnfo:statedIn .

cnfo:playsFundRole a owl:ObjectProperty ;
    rdfs:label "主体承担基金角色"@zh ;
    rdfs:domain cnfo:FundParty ;
    rdfs:range cnfo:FundRole ;
    owl:inverseOf cnfo:rolePlayedBy .

cnfo:policyOfFund a owl:ObjectProperty ;
    rdfs:label "投资政策对应基金"@zh ;
    rdfs:domain cnfo:FundInvestmentPolicy ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasInvestmentPolicy .

cnfo:portfolioOfFund a owl:ObjectProperty ;
    rdfs:label "投资组合对应基金"@zh ;
    rdfs:domain cnfo:FundPortfolio ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundPortfolio .

cnfo:positionAsOfDate a owl:DatatypeProperty ;
    rdfs:label "持仓日期"@zh ;
    rdfs:domain cnfo:PortfolioPosition ;
    rdfs:range xsd:date .

cnfo:positionOfPortfolio a owl:ObjectProperty ;
    rdfs:label "持仓对应投资组合"@zh ;
    rdfs:domain cnfo:PortfolioPosition ;
    rdfs:range cnfo:FundPortfolio ;
    owl:inverseOf cnfo:hasFundPortfolioPosition .

cnfo:positionQuantity a owl:DatatypeProperty ;
    rdfs:label "持仓数量"@zh ;
    rdfs:domain cnfo:FundPositionRecord ;
    rdfs:range xsd:decimal .

cnfo:providesCustodyForFundUnit a owl:ObjectProperty ;
    rdfs:label "托管基金份额"@zh ;
    rdfs:domain cnfo:FundDepositaryRole ;
    rdfs:range cnfo:FundUnit .

cnfo:redemptionTermsForFund a owl:ObjectProperty ;
    rdfs:label "赎回条款对应基金"@zh ;
    rdfs:domain cnfo:FundRedemptionTerms ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundRedemptionTerms .

cnfo:statusOfFund a owl:ObjectProperty ;
    rdfs:label "生命周期状态对应基金"@zh ;
    rdfs:domain cnfo:FundLifecycleStatus ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundStatus .

cnfo:stipulatesBenchmark a owl:ObjectProperty ;
    rdfs:label "规定业绩比较基准"@zh ;
    rdfs:domain cnfo:FundInvestmentPolicy ;
    rdfs:range cnfo:FundBenchmark .

cnfo:strategyOfFund a owl:ObjectProperty ;
    rdfs:label "投资策略对应基金"@zh ;
    rdfs:domain cnfo:FundInvestmentStrategy ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:usesInvestmentStrategy .

cnfo:subscriptionTermsForFund a owl:ObjectProperty ;
    rdfs:label "认购条款对应基金"@zh ;
    rdfs:domain cnfo:FundSubscriptionTerms ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundSubscriptionTerms .

cnfo:supervisesFund a owl:ObjectProperty ;
    rdfs:label "监管基金"@zh ;
    rdfs:domain cnfo:FundSupervisor ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundSupervisor .

cnfo:underlyingFundOf a owl:ObjectProperty ;
    rdfs:label "作为底层基金属于"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundOfFunds ;
    owl:inverseOf cnfo:hasUnderlyingFund .

cnfo:unitCurrency a owl:DatatypeProperty ;
    rdfs:label "基金份额币种"@zh ;
    rdfs:domain cnfo:FundUnit ;
    rdfs:range xsd:string .

cnfo:usesInvestmentStrategy a owl:ObjectProperty ;
    rdfs:label "使用投资策略"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundInvestmentStrategy ;
    rdfs:subPropertyOf cnfo:hasInvestmentSpecification ;
    owl:inverseOf cnfo:strategyOfFund .

cnfo:valuationCurrency a owl:DatatypeProperty ;
    rdfs:label "估值币种"@zh ;
    rdfs:domain cnfo:NetAssetValueRecord ;
    rdfs:range xsd:string .

cnfo:valuationDate a owl:DatatypeProperty ;
    rdfs:label "估值日期"@zh ;
    rdfs:domain cnfo:NetAssetValueRecord ;
    rdfs:range xsd:date .

cnfo:FundClassification a owl:Class ;
    rdfs:label "基金分类"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:classifiesFund ;
            owl:someValuesFrom cnfo:Fund ],
        cnfo:FundClassifier ;
    skos:definition "依据发布的分类体系对基金进行标识的分类概念。"@zh .

cnfo:FundContract a owl:Class ;
    rdfs:label "基金合同"@zh ;
    rdfs:subClassOf cnfo:FundDocument ;
    skos:definition "约定基金设立、当事人权利义务、投资运作和收益分配等事项的基金合同。"@zh .

cnfo:FundDepositaryRole a owl:Class ;
    rdfs:label "基金托管人角色"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:providesCustodyForFundUnit ;
            owl:someValuesFrom cnfo:FundUnit ],
        cnfo:FundServiceProviderRole ;
    skos:definition "由基金托管人承担、负责基金财产保管和相关监督职责的基金服务机构角色。"@zh .

cnfo:FundDistributionMethod a owl:Class ;
    rdfs:label "基金分红方式"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "基金收益向基金份额持有人分配时采用的具体方式。"@zh .

cnfo:FundEstate a owl:Class ;
    rdfs:label "基金财产"@zh ;
    rdfs:subClassOf cnfo:FundBusinessObject ;
    skos:definition "独立于管理人、托管人固有财产的基金资产、权利和负债集合。"@zh .

cnfo:FundManagerRole a owl:Class ;
    rdfs:label "基金管理人角色"@zh ;
    rdfs:subClassOf cnfo:FundServiceProviderRole ;
    skos:definition "由基金管理人承担、负责基金投资管理和基金运作管理的基金服务机构角色。"@zh .

cnfo:FundPortfolioInvestmentPolicy a owl:Class ;
    rdfs:label "基金投资组合政策"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass cnfo:FundBenchmark ;
            owl:onProperty cnfo:stipulatesBenchmark ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:definesInvestmentRestriction ;
            owl:someValuesFrom cnfo:FundInvestmentRestriction ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:governsInvestmentStrategy ;
            owl:someValuesFrom cnfo:FundInvestmentStrategy ],
        cnfo:FundInvestmentPolicy ;
    skos:definition "规定基金投资组合配置原则、投资限制和执行策略的投资政策。"@zh .

cnfo:FundProcessingTerms a owl:Class ;
    rdfs:label "基金运作条款"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "规定基金份额申购、赎回、分配或其他处理流程和条件的运作条款。"@zh .

cnfo:FundSupervisor a owl:Class ;
    rdfs:label "基金监管机构"@zh ;
    rdfs:subClassOf cnfo:FundParty ;
    skos:definition "依法对基金设立、募集、运作或相关主体实施监督管理的基金参与主体。"@zh .

cnfo:SecuritiesInvestmentFund a owl:Class ;
    rdfs:label "证券投资基金"@zh ;
    rdfs:subClassOf cnfo:Fund ;
    skos:definition "以证券及其衍生品等规定标的为主要投资对象的基金。"@zh .

cnfo:assignmentForFund a owl:ObjectProperty ;
    rdfs:label "任职记录对应基金"@zh ;
    rdfs:domain cnfo:FundRoleAssignment ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundRoleAssignment .

cnfo:classifiesFund a owl:ObjectProperty ;
    rdfs:label "分类标识基金"@zh ;
    rdfs:domain cnfo:FundClassifier ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundClassifier .

cnfo:definedInProspectus a owl:ObjectProperty ;
    rdfs:label "投资限制载明于招募说明书"@zh ;
    rdfs:domain cnfo:FundInvestmentRestriction ;
    rdfs:range cnfo:FundProspectus ;
    owl:inverseOf cnfo:hasInvestmentRestriction .

cnfo:distributionWithReinvestment a owl:DatatypeProperty ;
    rdfs:label "是否收益再投资"@zh ;
    rdfs:domain cnfo:FundUnitDistributionPolicy ;
    rdfs:range xsd:boolean .

cnfo:effectiveFrom a owl:DatatypeProperty ;
    rdfs:label "生效日期"@zh ;
    rdfs:domain cnfo:FundTemporalRecord ;
    rdfs:range xsd:date .

cnfo:effectiveTo a owl:DatatypeProperty ;
    rdfs:label "失效日期"@zh ;
    rdfs:domain cnfo:FundTemporalRecord ;
    rdfs:range xsd:date .

cnfo:hasFundClassifier a owl:ObjectProperty ;
    rdfs:label "具有基金分类概念"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundClassifier ;
    owl:inverseOf cnfo:classifiesFund .

cnfo:hasFundDocument a owl:ObjectProperty ;
    rdfs:label "具有基金文件"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundDocument ;
    rdfs:subPropertyOf cnfo:hasFundObject .

cnfo:hasFundParty a owl:ObjectProperty ;
    rdfs:label "具有基金参与主体"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundParty .

cnfo:hasFundPortfolioPosition a owl:ObjectProperty ;
    rdfs:label "具有投资组合持仓"@zh ;
    rdfs:domain cnfo:FundPortfolio ;
    rdfs:range cnfo:PortfolioPosition ;
    owl:inverseOf cnfo:positionOfPortfolio .

cnfo:hasFundProduct a owl:ObjectProperty ;
    rdfs:label "具有基金产品"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundProduct ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:fundProductOf .

cnfo:hasFundRole a owl:ObjectProperty ;
    rdfs:label "具有基金角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundRole ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:roleInFund .

cnfo:hasFundStatusRecord a owl:ObjectProperty ;
    rdfs:label "具有基金状态记录"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundStatusRecord ;
    rdfs:subPropertyOf cnfo:hasFundRecord ;
    owl:inverseOf cnfo:statusRecordForFund .

cnfo:hasUnderlyingFund a owl:ObjectProperty ;
    rdfs:label "具有底层基金"@zh ;
    rdfs:domain cnfo:FundOfFunds ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:underlyingFundOf .

cnfo:heldByInvestor a owl:ObjectProperty ;
    rdfs:label "基金份额头寸由投资者持有"@zh ;
    rdfs:domain cnfo:FundPosition ;
    rdfs:range cnfo:Investor ;
    owl:inverseOf cnfo:holdsFundPosition .

cnfo:isOpenEnded a owl:DatatypeProperty ;
    rdfs:label "是否开放式"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:boolean .

cnfo:isPrivate a owl:DatatypeProperty ;
    rdfs:label "是否私募"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range xsd:boolean .

cnfo:issuedByFund a owl:ObjectProperty ;
    rdfs:label "基金份额由基金发行"@zh ;
    rdfs:domain cnfo:FundUnit ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundUnit .

cnfo:positionInAsset a owl:ObjectProperty ;
    rdfs:label "持仓对应投资资产"@zh ;
    rdfs:domain cnfo:PortfolioPosition ;
    rdfs:range cnfo:FundInvestmentAsset ;
    owl:inverseOf cnfo:assetHasPortfolioPosition .

cnfo:positionInFundUnit a owl:ObjectProperty ;
    rdfs:label "头寸对应基金份额"@zh ;
    rdfs:domain cnfo:FundPosition ;
    rdfs:range cnfo:FundUnit ;
    owl:inverseOf cnfo:hasFundPosition .

cnfo:recordForFund a owl:ObjectProperty ;
    rdfs:label "净值记录对应基金"@zh ;
    rdfs:domain cnfo:NetAssetValueRecord ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasNetAssetValueRecord .

cnfo:roleInFund a owl:ObjectProperty ;
    rdfs:label "角色适用于基金"@zh ;
    rdfs:domain cnfo:FundRole ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundRole .

cnfo:rolePlayedBy a owl:ObjectProperty ;
    rdfs:label "角色由主体承担"@zh ;
    rdfs:domain cnfo:FundRole ;
    rdfs:range cnfo:FundParty ;
    owl:inverseOf cnfo:playsFundRole .

cnfo:statedIn a owl:ObjectProperty ;
    rdfs:label "载明于基金招募说明书"@zh ;
    rdfs:domain cnfo:FundInvestmentObjective ;
    rdfs:range cnfo:FundProspectus ;
    owl:inverseOf cnfo:outlinesObjective .

cnfo:statusRecordForFund a owl:ObjectProperty ;
    rdfs:label "状态记录对应基金"@zh ;
    rdfs:domain cnfo:FundStatusRecord ;
    rdfs:range cnfo:Fund ;
    owl:inverseOf cnfo:hasFundStatusRecord .

cnfo:FundBenchmark a owl:Class ;
    rdfs:label "业绩比较基准"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "用于评价基金投资组合或投资策略相对表现的业绩比较基准。"@zh .

cnfo:FundJurisdiction a owl:Class ;
    rdfs:label "基金适用法域"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "适用于基金设立、募集或运作的法律和监管辖域。"@zh .

cnfo:FundOfFunds a owl:Class ;
    rdfs:label "基金中基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasUnderlyingFund ;
            owl:someValuesFrom cnfo:Fund ],
        cnfo:Fund ;
    skos:definition "主要投资其他基金份额的基金，也称 FOF。"@zh .

cnfo:FundPortfolioInvestmentLimitation a owl:Class ;
    rdfs:label "基金组合投资限制"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentRestriction ;
    skos:definition "限制基金投资组合在特定资产、行业、地区或比例方面配置范围的规则对象。"@zh .

cnfo:FundProduct a owl:Class ;
    rdfs:label "基金产品"@zh ;
    rdfs:subClassOf cnfo:FundBusinessObject ;
    skos:definition "由基金名称、目标、策略、份额、费率和运作规则共同定义的基金产品。"@zh .

cnfo:FundRecord a owl:Class ;
    rdfs:label "基金业务记录"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "用于记录基金在特定日期或期间的状态、估值或其他事实的对象。"@zh .

cnfo:FundRiskLevel a owl:Class ;
    rdfs:label "基金风险等级"@zh ;
    rdfs:subClassOf cnfo:FundClassifier ;
    skos:definition "用于表示基金或其投资目标对应风险程度的风险分类概念。"@zh .

cnfo:FundUnitClass a owl:Class ;
    rdfs:label "基金份额类别"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasDistributionPolicy ;
            owl:someValuesFrom cnfo:FundUnitDistributionPolicy ],
        cnfo:FundUnit ;
    skos:definition "按照收费、收益分配、销售渠道或其他规则划分的基金份额类别。"@zh .

cnfo:OpenEndedFund a owl:Class ;
    rdfs:label "开放式基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty cnfo:isOpenEnded ],
        cnfo:Fund ;
    owl:disjointWith cnfo:ClosedEndedFund ;
    skos:definition "基金份额总额不固定，可以按照基金合同办理申购和赎回的基金。"@zh .

cnfo:hasFundRecord a owl:ObjectProperty ;
    rdfs:label "具有基金记录"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundRecord ;
    rdfs:subPropertyOf cnfo:hasFundObject .

cnfo:hasFundUnit a owl:ObjectProperty ;
    rdfs:label "具有基金份额"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundUnit ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:issuedByFund .

cnfo:hasInvestmentSpecification a owl:ObjectProperty ;
    rdfs:label "具有投资说明"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundInvestmentSpecification ;
    rdfs:subPropertyOf cnfo:hasFundObject .

cnfo:hasLegalStructure a owl:ObjectProperty ;
    rdfs:label "具有基金组织形式"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundLegalStructure ;
    rdfs:subPropertyOf cnfo:hasFundObject ;
    owl:inverseOf cnfo:legalStructureOf .

cnfo:ConceptNature a owl:Class ;
    rdfs:label "概念性质"@zh ;
    skos:definition "用于区分基金概念在法律规定、监管产品分类或市场惯用语境中性质的概念类型。"@zh .

cnfo:FundRedemptionTerms a owl:Class ;
    rdfs:label "基金赎回条款"@zh ;
    rdfs:subClassOf cnfo:FundProcessingTerms ;
    skos:definition "规定基金份额赎回条件、流程、费用、最低数量及资金处理方式的运作条款。"@zh .

cnfo:FundRoleAssignment a owl:Class ;
    rdfs:label "基金角色任职记录"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:Fund ;
            owl:onProperty cnfo:assignmentForFund ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass cnfo:FundRole ;
            owl:onProperty cnfo:assignsFundRole ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass cnfo:FundParty ;
            owl:onProperty cnfo:assignmentPlayedBy ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:effectiveFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cnfo:effectiveTo ],
        cnfo:FundTemporalRecord ;
    skos:definition "记录某一基金角色由何主体在何期间承担的时态事实。"@zh .

cnfo:FundStatusRecord a owl:Class ;
    rdfs:label "基金状态记录"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:Fund ;
            owl:onProperty cnfo:statusRecordForFund ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass cnfo:FundLifecycleStatus ;
            owl:onProperty cnfo:hasStatusValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:effectiveFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cnfo:effectiveTo ],
        cnfo:FundTemporalRecord ;
    skos:definition "基金在特定生效期间所处生命周期状态的事实记录。"@zh .

cnfo:FundTemporalRecord a owl:Class ;
    rdfs:label "基金时态记录"@zh ;
    rdfs:subClassOf cnfo:FundRecord ;
    skos:definition "带有生效起止时间、用于表达基金随时间变化事实的业务记录。"@zh .

cnfo:PublicFund a owl:Class ;
    rdfs:label "公募基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty cnfo:isPrivate ],
        cnfo:Fund ;
    owl:disjointWith cnfo:PrivateFund ;
    skos:definition "依法公开募集并按照适用规则注册、运作的基金。"@zh .

cnfo:FundDocument a owl:Class ;
    rdfs:label "基金文件"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "用于设立、募集、运作、披露或备案的基金业务文件。"@zh .

cnfo:FundInvestmentRestriction a owl:Class ;
    rdfs:label "基金投资限制"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:definedInProspectus ;
            owl:someValuesFrom cnfo:FundProspectus ],
        cnfo:FundObject ;
    skos:definition "约束基金可投资资产、地区、行业、比例或风险水平的规则对象。"@zh .

cnfo:FundInvestmentSpecification a owl:Class ;
    rdfs:label "基金投资说明"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "描述基金投资目标、政策或策略的语义对象。"@zh .

cnfo:FundPosition a owl:Class ;
    rdfs:label "基金份额持仓"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:FundUnit ;
            owl:onProperty cnfo:positionInFundUnit ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass cnfo:Investor ;
            owl:onProperty cnfo:heldByInvestor ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:positionQuantity ],
        cnfo:FundPositionRecord ;
    skos:definition "投资者在特定基金份额上持有的数量、权益或相关头寸记录。"@zh .

cnfo:FundSubscriptionTerms a owl:Class ;
    rdfs:label "基金认购条款"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:appliesToFundUnit ;
            owl:someValuesFrom cnfo:FundUnit ],
        cnfo:FundProcessingTerms ;
    skos:definition "规定基金份额认购条件、流程、费用、最低金额或最低份额的运作条款。"@zh .

cnfo:Investor a owl:Class ;
    rdfs:label "基金投资者"@zh ;
    rdfs:subClassOf cnfo:FundParty ;
    skos:definition "以认购、申购或其他方式持有基金份额并享有相应权利的基金参与主体。"@zh .

cnfo:PrivateFund a owl:Class ;
    rdfs:label "私募基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty cnfo:isPrivate ],
        cnfo:Fund ;
    skos:definition "依法向合格投资者非公开募集并按照适用规则登记备案的基金。"@zh .

cnfo:FundClassifier a owl:Class ;
    rdfs:label "基金分类概念"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "用于标识、区分或组织基金分类信息的分类概念或分类对象。"@zh .

cnfo:FundInvestmentAsset a owl:Class ;
    rdfs:label "基金投资资产"@zh ;
    rdfs:subClassOf cnfo:FundBusinessObject ;
    skos:definition "基金投资组合中可被持有、估值或交易的投资标的或资产对象。"@zh .

cnfo:FundInvestmentPolicy a owl:Class ;
    rdfs:label "基金投资政策"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentSpecification ;
    skos:definition "规定基金投资范围、限制、原则和决策边界的投资说明。"@zh .

cnfo:FundPortfolio a owl:Class ;
    rdfs:label "基金投资组合"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasPortfolioInvestmentStrategy ;
            owl:someValuesFrom cnfo:FundInvestmentStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:implementsInvestmentPolicy ;
            owl:someValuesFrom cnfo:FundPortfolioInvestmentPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:hasFundPortfolioPosition ;
            owl:someValuesFrom cnfo:PortfolioPosition ],
        cnfo:FundBusinessObject ;
    skos:definition "基金财产中按投资目标和投资政策组织的资产与头寸集合。"@zh .

cnfo:FundUnitDistributionPolicy a owl:Class ;
    rdfs:label "基金份额分配政策"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasDistributionMethod ;
            owl:someValuesFrom cnfo:FundDistributionMethod ],
        cnfo:FundDistributionPolicy ;
    skos:definition "规定特定基金份额类别收益分配和再投资方式的份额分配政策。"@zh .

cnfo:NetAssetValueRecord a owl:Class ;
    rdfs:label "基金净值记录"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:Fund ;
            owl:onProperty cnfo:recordForFund ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:valuationDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:valuationCurrency ],
        cnfo:FundRecord ;
    skos:definition "在特定估值日期记录基金资产净值、份额净值及相关币种的业务记录。"@zh .

cnfo:FundInvestmentObjective a owl:Class ;
    rdfs:label "基金投资目标"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasIntendedRiskLevel ;
            owl:someValuesFrom cnfo:FundRiskLevel ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:statedIn ;
            owl:someValuesFrom cnfo:FundProspectus ],
        cnfo:FundInvestmentSpecification ;
    skos:definition "规定基金拟实现的投资目的、收益目标或风险收益取向的投资说明。"@zh .

cnfo:hasFundServiceProviderRole a owl:ObjectProperty ;
    rdfs:label "具有基金服务机构角色"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundServiceProviderRole ;
    rdfs:subPropertyOf cnfo:hasFundRole .

cnfo:FundLegalStructure a owl:Class ;
    rdfs:label "基金组织形式"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasApplicableJurisdiction ;
            owl:someValuesFrom cnfo:FundJurisdiction ],
        cnfo:FundObject ;
    skos:definition "规定基金组织形式、权利义务和适用法律关系的基金法律结构。"@zh .

cnfo:FundProspectus a owl:Class ;
    rdfs:label "基金招募说明书"@zh ;
    rdfs:subClassOf cnfo:FundDocument ;
    skos:definition "向投资者披露基金基本情况、投资目标、投资策略、风险和运作规则的基金招募说明书。"@zh .

cnfo:FundRole a owl:Class ;
    rdfs:label "基金角色"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:Fund ;
            owl:onProperty cnfo:roleInFund ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass cnfo:FundParty ;
            owl:onProperty cnfo:rolePlayedBy ;
            owl:qualifiedCardinality 1 ],
        cnfo:FundObject ;
    skos:definition "由基金参与主体承担、并限定其在特定基金中职责的角色对象。"@zh .

cnfo:PortfolioPosition a owl:Class ;
    rdfs:label "投资组合持仓"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:FundInvestmentAsset ;
            owl:onProperty cnfo:positionInAsset ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:positionAsOfDate ],
        cnfo:FundPositionRecord ;
    skos:definition "反映基金投资组合在特定日期对某项投资资产持有数量、价值或比例的持仓对象。"@zh .

cnfo:FundInvestmentStrategy a owl:Class ;
    rdfs:label "基金投资策略"@zh ;
    rdfs:subClassOf cnfo:FundInvestmentSpecification ;
    skos:definition "规定基金实现投资目标所采用的资产配置、选券或交易方法的投资说明。"@zh .

cnfo:FundParty a owl:Class ;
    rdfs:label "基金参与主体"@zh ;
    skos:definition "参与基金设立、募集、投资、托管、销售、监督或其他基金业务的主体。"@zh .

cnfo:FundServiceProviderRole a owl:Class ;
    rdfs:label "基金服务机构角色"@zh ;
    rdfs:subClassOf cnfo:FundRole ;
    skos:definition "由为基金提供专业服务的机构承担的基金服务机构角色。"@zh .

cnfo:FundActivity a owl:Class ;
    rdfs:label "基金业务活动"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "围绕基金设立、募集、投资运作、估值、披露、清算等发生的业务活动。"@zh .

cnfo:FundLifecycleStatus a owl:Class ;
    rdfs:label "基金生命周期状态"@zh ;
    rdfs:subClassOf cnfo:FundObject ;
    skos:definition "表示基金从设计、注册备案、募集、运作到清算终止所处阶段的状态概念。"@zh .

cnfo:hasFundObject a owl:ObjectProperty ;
    rdfs:label "具有基金对象"@zh ;
    rdfs:domain cnfo:Fund ;
    rdfs:range cnfo:FundObject .

cnfo:FundUnit a owl:Class ;
    rdfs:label "基金份额"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cnfo:Fund ;
            owl:onProperty cnfo:issuedByFund ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cnfo:unitCurrency ],
        cnfo:FundBusinessObject ;
    skos:definition "表示基金份额持有人对基金财产享有权益的可识别基金份额对象。"@zh .

cnfo:FundObject a owl:Class ;
    rdfs:label "基金领域对象"@zh ;
    skos:definition "基金领域中可被识别、描述、关联或记录的业务对象。"@zh .

cnfo:Fund a owl:Class ;
    rdfs:label "基金"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cnfo:hasLegalStructure ;
            owl:someValuesFrom cnfo:FundLegalStructure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass cnfo:FundLegalStructure ;
            owl:onProperty cnfo:hasLegalStructure ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:hasFundManagerRole ;
            owl:someValuesFrom cnfo:FundManagerRole ],
        [ a owl:Restriction ;
            owl:onProperty cnfo:hasFundStatusRecord ;
            owl:someValuesFrom cnfo:FundStatusRecord ],
        cnfo:FundBusinessObject ;
    skos:definition "在中国基金行业语境下依法设立、募集或形成并开展投资运作的基金对象。"@zh .

[] a owl:AllDisjointClasses ;
    owl:members ( cnfo:ContractualFundStructure cnfo:CorporateFundStructure cnfo:PartnershipFundStructure ) .

[] a owl:AllDisjointClasses ;
    owl:members ( cnfo:DesignedStatus cnfo:RegistrationPendingStatus cnfo:RegisteredStatus cnfo:RaisingStatus cnfo:FiledStatus cnfo:OperatingStatus cnfo:SuspendedStatus cnfo:LiquidatingStatus cnfo:TerminatedStatus ) .

[] a owl:AllDisjointClasses ;
    owl:members ( cnfo:FundCashDistributionPolicy cnfo:FundReinvestmentPolicy ) .

