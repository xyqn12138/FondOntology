[Unit]
Description=FondOntology CNFO viewer service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际部署路径和用户修改这两行
User=ubuntu
WorkingDirectory=/opt/fondontology
# uv 需要能写缓存目录，保持用户环境变量
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/.local/bin/uv run python -m fondontology.explorer --mode viewer --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# 2G 内存保护：限制进程内存，超限自动重启
MemoryMax=1200M
# 加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
